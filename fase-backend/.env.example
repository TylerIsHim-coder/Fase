PORT=3001
NODE_ENV=development

STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Path to Firebase service account JSON file (recommended)
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# Or paste the whole JSON as one line (alternative)
FIREBASE_SERVICE_ACCOUNT=

# Used for Stripe Connect onboarding redirect URLs when not passed in request body.
# Live Stripe Connect redirects — hosted on Firebase (public/connect/)
STRIPE_CONNECT_APP_URL=https://fase-6c49a.web.app

# Used for other backend URLs when not passed in request body
APP_URL=https://fase-6c49a.web.app

TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Groq — contest brief generation
GROQ_API_KEY=
# Optional override (default: llama-3.3-70b-versatile)
GROQ_MODEL=
